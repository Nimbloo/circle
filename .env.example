# ─────────────────────────────────────────────────────────────────────────────
# Circle — variáveis de ambiente. Copie para `.env.local` e preencha.
# Em produção (EKS) estas vêm do chart (appEnv) + Secret circle-prd-secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco (obrigatório) ──────────────────────────────────────────────────────
# Postgres local: `docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=circle -e POSTGRES_DB=circle postgres:16`
# As migrations rodam no boot (instrumentation.ts).
DATABASE_URL=postgres://postgres:circle@localhost:5432/circle

# ── Auth / NextAuth (obrigatório) ────────────────────────────────────────────
# Gere: `openssl rand -base64 32`
AUTH_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# SSO via Keycloak (realm nimbloo-internal, client "circle") — único provider de login.
# Acesso exige pertencer ao grupo Keycloak `app-circle` (ver auth.config.ts).
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=https://keycloak.nimbloo.ai/realms/nimbloo-internal
CIRCLE_KEYCLOAK_ALLOWED_CLIENTS=              # csv de clients (azp/aud) autorizados p/ auth de máquina (Bearer). VAZIO = Bearer desligado

# ── Workspace / seed ─────────────────────────────────────────────────────────
CIRCLE_WORKSPACE_SLUG=nimbloo
CIRCLE_ADMIN_EMAILS=voce@nimbloo.ai
# `true` semeia dados demo no boot (útil em dev). NUNCA true em prd.
CIRCLE_SEED_DEMO=true

# ── Integrações (opcionais — deixe vazio para desabilitar) ───────────────────
CIRCLE_MAIL_FROM=no-reply@nimbloo.ai        # SES (envio de convites/notificação)
CIRCLE_GITHUB_REPOS=                         # csv owner/repo para a aba Reviews
GITHUB_TOKEN=                                # SECRETO — token do GitHub (Reviews)
CIRCLE_GITHUB_WEBHOOK_SECRET=                # SECRETO — HMAC do webhook do GitHub (link PR↔issue em tempo real)
SLACK_WEBHOOK_URL=                           # SECRETO — Incoming Webhook (notificações/teste)
CIRCLE_SENTRY_CLIENT_SECRET=                 # SECRETO — HMAC da integração Sentry

# ── Sentry (error tracking do próprio Circle) ────────────────────────────────
# NÃO é a integração acima (aquela cria issue A PARTIR do Sentry). Esta manda os
# erros do Circle PARA o Sentry. Vazio = SDK inerte (nada é enviado em dev/teste).
# O DSN é público por design — identifica o projeto, não autentica.
# ATENCAO: NEXT_PUBLIC_* sao EMBUTIDOS no bundle do browser em `next build`. Em
# producao o valor precisa existir no BUILD (build arg do Dockerfile, alimentado pela
# variavel de repo NEXT_PUBLIC_SENTRY_DSN no CI) — definir so no chart ativa server e
# edge e deixa o cliente mudo. Local, o .env.local basta.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_CIRCLE_ENV=development           # vira o `environment` no Sentry (production em prd)
SENTRY_AUTH_TOKEN=                           # SECRETO — só no build do CI, habilita upload de source maps

# ── AWS (opcionais — features que usam a cloud) ──────────────────────────────
AWS_REGION=us-east-1
# Agent (IA): modelo Bedrock. Precisa de credenciais AWS + model access habilitado.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Custom emojis: bucket S3 + CDN. Vazio = tela de Emojis responde 503 (resto intacto).
CIRCLE_ASSETS_BUCKET=
CIRCLE_CDN_URL=
